# Root .gitignore for Microservices Monorepo

# Independent previous demo projects (they have their own repos)
oauth-service-demo/
firebase-auth-demo/

# Dependencies
**/node_modules/
node_modules/

# Build outputs
**/dist/
dist/

# Environment variables — NEVER COMMIT SECRETS
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs
**/*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE, AI tools & Private documentation
.vscode/
.idea/
.agents/
.claude/
.windsurf/
skills-lock.json
HANDOFF.md
**/HANDOFF.md
ROADMAP.md
**/ROADMAP.md
*.local
*.secret

# NestJS / TypeScript cache
**/*.tsbuildinfo
.tsbuildinfo

# Test coverage
**/coverage/

# Generated Prisma Client
**/src/generated/prisma/
