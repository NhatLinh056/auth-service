# Root .gitignore for Microservices Monorepo

# Independent previous demo projects (they have their own repos)
oauth-service-demo/
firebase-auth-demo/

# Dependencies
**/node_modules/
node_modules/

# Build outputs
**/dist/
dist/

# Environment variables — NEVER COMMIT SECRETS
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs
**/*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE, AI tools & Private documentation
.vscode/
.idea/
.agents/
.claude/
.windsurf/
skills-lock.json
HANDOFF.md
**/HANDOFF.md
AGENTS.md
**/AGENTS.md
ROADMAP.md
**/ROADMAP.md
*.local
*.secret
*.rar
*.zip
*.7z
env.rar
.local-backups/

# NestJS / TypeScript cache
**/*.tsbuildinfo
.tsbuildinfo

# Test coverage
**/coverage/

# Local tests and test utilities
**/*.spec.ts
**/test/
**/vitest.config*.ts
auth-service/scripts/security-check.mjs
auth-service/scripts/phase2-phase3-full-test.mjs
auth-service/scripts/check-secrets.mjs
.github/workflows/secret-check.yml

# Generated Prisma Client
**/src/generated/prisma/

# Personal documents & drafts
*.docx
*.doc
