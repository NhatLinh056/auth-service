# Port cho Demo Service (tránh xung đột với Auth Service cổng 3000)
PORT=3001
# Public Portal origin behind the reverse proxy; use HTTPS in production.
PUBLIC_URL=http://localhost:3001

# Địa chỉ URL của Central Auth Service
AUTH_SERVICE_URL=http://localhost:3000

# Khóa định danh ứng dụng mẫu (Khớp sẵn 100% với dữ liệu seed của Auth Service)
# Người dùng clone về chỉ cần copy file này thành .env là hệ thống tự động kết nối được ngay!
APP_ID=app_22c57454b00eb44a55c66bf4
APP_TOKEN=apt_replace_with_your_generated_token
