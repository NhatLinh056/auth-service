// Prisma Schema for Central Identity Provider (Auth Service)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum AppStatus {
  ACTIVE
  INACTIVE
}

enum OAuthProviderType {
  GOOGLE
  FACEBOOK
}

enum TenantJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String?
  name         String?
  role         Role            @default(USER)
  emailVerifiedAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  applications Application[]
  identities   OAuthIdentity[]
  appMemberships AppUser[]
  tenantId     String?
  tenant       Tenant?         @relation("TenantMembers", fields: [tenantId], references: [id], onDelete: SetNull)
  ownedTenant  Tenant?         @relation("TenantOwner")
  joinRequests TenantJoinRequest[] @relation("UserJoinRequests")

  @@index([tenantId])
  @@map("users")
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerUserId String   @unique
  owner       User     @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  users       User[]   @relation("TenantMembers")
  joinRequests TenantJoinRequest[] @relation("TenantJoinRequests")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tenants")
}

model TenantJoinRequest {
  id        String                  @id @default(uuid())
  userId    String
  user      User                    @relation("UserJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant                  @relation("TenantJoinRequests", fields: [tenantId], references: [id], onDelete: Cascade)
  status    TenantJoinRequestStatus @default(PENDING)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@map("tenant_join_requests")
}

model TenantAuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  tenantName  String
  actorUserId String
  action      String
  fromOwnerId String?
  toOwnerId   String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("tenant_audit_logs")
}

model OAuthIdentity {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProviderType
  providerScope  String            @default("legacy")
  providerUserId String
  email          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([provider, providerScope, providerUserId])
  @@index([userId])
  @@map("oauth_identities")
}

model OAuthProvider {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  provider      OAuthProviderType
  name          String
  isEnabled     Boolean           @default(false)
  clientId      String?
  clientSecret  String?
  callbackUrl   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([applicationId, provider])
  @@index([applicationId])
  @@map("oauth_providers")
}

model Application {
  id             String          @id @default(uuid())
  name           String
  appId          String          @unique
  appToken       String
  status         AppStatus       @default(ACTIVE)
  adminEmails    String[]        @default([])
  allowedRedirectUris String[]    @default([])
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthProviders OAuthProvider[]
  appUsers       AppUser[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@map("applications")
}

model AppUser {
  id            String             @id @default(uuid())
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  email         String
  name          String?
  avatarUrl     String?
  role          Role               @default(USER)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([id, applicationId])
  @@unique([applicationId, email])
  @@unique([applicationId, userId])
  @@index([userId])
  @@index([applicationId])
  @@map("app_users")
}
