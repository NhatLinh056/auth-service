// Prisma Schema for Central Identity Provider (Auth Service)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum AppStatus {
  ACTIVE
  INACTIVE
}

enum OAuthProviderType {
  GOOGLE
  FACEBOOK
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String?
  name         String?
  role         Role            @default(USER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  applications Application[]
  identities   OAuthIdentity[]

  @@map("users")
}

model OAuthIdentity {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProviderType
  providerUserId String
  email          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_identities")
}

model OAuthProvider {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  provider      OAuthProviderType
  name          String
  isEnabled     Boolean           @default(false)
  clientId      String?
  clientSecret  String?
  callbackUrl   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([applicationId, provider])
  @@index([applicationId])
  @@map("oauth_providers")
}

model Application {
  id             String          @id @default(uuid())
  name           String
  appId          String          @unique
  appToken       String
  status         AppStatus       @default(ACTIVE)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthProviders OAuthProvider[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@map("applications")
}
