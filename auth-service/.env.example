# Server Configuration
PORT=3000

# PostgreSQL Database Connection URL
# Thay thế USER và PASSWORD bằng tài khoản cơ sở dữ liệu trên máy bạn
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_service_db"

# JWT Secret Key & Token Expiry
JWT_SECRET=super_secret_jwt_key_microservice_platform_2026
JWT_EXPIRES_IN=7d

# Default Platform Administrator (tùy chọn - mặc định admin@example.com / Admin123!)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin123!

# OAuth Credentials (Điền thông tin Google Cloud Console & Meta for Developers của bạn)
# Nếu chưa có, ứng dụng vẫn khởi động bình thường với các tính năng mật khẩu và seed data
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
