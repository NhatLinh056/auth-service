# Server Configuration
PORT=3000
# Public Auth origin behind the reverse proxy; use HTTPS in production.
AUTH_PUBLIC_URL=http://localhost:3000

# PostgreSQL Database Connection URL
# Thay thế USER và PASSWORD bằng tài khoản cơ sở dữ liệu trên máy bạn
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_service_db"

# JWT Secret Key & Token Expiry
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# Default Platform Administrator (tùy chọn - mặc định admin@example.com / Admin123!)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin123!

# Danh sách Email ủy quyền Admin khi chạy seed (phân cách bằng dấu phẩy)
# Ví dụ: SEED_ADMIN_EMAILS="developer@example.com,your_personal_email@example.com"
SEED_ADMIN_EMAILS="developer@example.com,manager@example.com"

# OAuth Credentials (Điền thông tin Google Cloud Console & Meta for Developers của bạn)
# Nếu chưa có, ứng dụng vẫn khởi động bình thường với các tính năng mật khẩu và seed data
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# Explicit opt-in for local demo data only
ENABLE_DEMO_SEED=false
SEED_APP_TOKEN=apt_replace_with_your_generated_token
SEED_REDIRECT_URI=http://localhost:3001/
